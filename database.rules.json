{
  "rules": {
    "sudokuRooms": {
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid)",
        ".validate": "!newData.exists() || !data.exists() || newData.child('hostUid').val() === data.child('hostUid').val()",
        "players": {
          "$playerUid": {
            ".write": "auth != null && auth.uid === $playerUid",
            ".validate": "newData.hasChildren(['name', 'progress', 'completed']) && newData.child('progress').isNumber() && newData.child('progress').val() >= 0 && newData.child('progress').val() <= 1 && newData.child('completed').isBoolean()"
          }
        }
      }
    }
  }
}

